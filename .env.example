# LLM Configuration - Choose one provider
# Options: openai | googleai | ollama
LLM_PROVIDER=ollama

# Ollama Configuration (FREE - Local, CPU-only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Google AI Studio (FREE - Recommended for cloud testing)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Paid)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4-turbo-preview

# Database Configuration
DATABASE_URL=postgresql://meetmind:meetmind_dev_password@localhost:5432/meetmind
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=meetmind_dev_password
POSTGRES_DB=meetmind

# Backend Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# n8n Configuration
N8N_HOST=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key-here

# CORS
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here

# Session
SESSION_SECRET=your-session-secret-here-change-in-production
